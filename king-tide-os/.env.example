# King Tide OS configuration. Copy to .env (never commit .env).

# demo = fictional sample data, no external calls (safe for class demos)
# live = real Zoho Bigin data, read-only
KTOS_DATA_MODE=demo
PORT=3000

# --- Zoho Bigin (live mode only). These stay on the server. ---
# Create a "Self Client" at https://api-console.zoho.com and generate a refresh
# token with the read-only scopes:
#   ZohoBigin.modules.pipelines.READ,ZohoBigin.settings.fields.READ
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Change these if the Zoho account is not in the US data center (.eu, .in, ...)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_URL=https://www.zohoapis.com
# Optional link back to the Bigin record; {id} is replaced with the record id.
# Copy the address of any deal opened in Bigin and swap its id for {id}.
BIGIN_RECORD_URL_TEMPLATE=

# --- Users (live mode). JSON list of approved founders. Roles: CEO CTO CMO CPO FOUNDER ---
# KTOS_USERS=[{"email":"you@example.com","name":"Your Name","role":"CEO"}]
KTOS_USERS=

# Show the sign-in code on screen instead of emailing it. Demo only; defaults
# to on in demo mode and off in live mode.
# KTOS_SHOW_LOGIN_CODES=true

# Set to true behind HTTPS so the session cookie is marked Secure.
KTOS_SECURE_COOKIES=false
# Demo aid for showing failure isolation (TC-04): make Bigin look down.
KTOS_SIMULATE_BIGIN_OUTAGE=false
